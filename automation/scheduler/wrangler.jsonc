{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daily-market-scheduler",
  "main": "scheduler.mjs",
  "compatibility_date": "2026-11-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "SOURCE_REPO": "PeidongGao/Daily_Market_Tracker",
    "MIRROR_REPO": "WillGaoLab/Daily_Market_Tracker",
    "BRANCH": "main"
  },
  "triggers": {
    // UTC covers both Eastern offsets; the handler accepts only 16:20/25/30 NY.
    "crons": ["20,25,30 20,21 * * MON-FRI"]
  }
}
